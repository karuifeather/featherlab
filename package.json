{
  "name": "featherlab",
  "version": "0.1.0",
  "description": "Local-first hands-on Kubernetes training",
  "type": "module",
  "bin": {
    "featherlab": "./bin/featherlab.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "test": "node --test",
    "dev:web": "vite --config web/vite.config.js",
    "start": "node bin/featherlab.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "dockerode": "^4.0.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0",
    "@xterm/addon-webgl": "^0.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karuifeather/featherlab.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
