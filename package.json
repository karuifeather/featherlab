{
  "name": "featherlab",
  "version": "2.1.1",
  "description": "Free, open-source Kubernetes practice labs — real kind cluster, guided exercises, automated grading. CKA, CKAD, CKS readiness.",
  "keywords": [
    "kubernetes",
    "k8s",
    "kubernetes-labs",
    "learn-kubernetes",
    "kubernetes-practice",
    "cka",
    "ckad",
    "cks",
    "kubectl",
    "kind",
    "devops",
    "devops-learning",
    "container-orchestration",
    "open-source"
  ],
  "homepage": "https://karuifeather.github.io/featherlab/",
  "type": "module",
  "bin": {
    "featherlab": "./bin/featherlab.mjs"
  },
  "files": [
    "bin",
    "src",
    "exercises",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/reporters/bail.mjs --test-reporter-destination=stderr \"test/unit/**/*.test.mjs\" \"test/packaging/**/*.test.mjs\"",
    "dev:web": "vite --config web/vite.config.js",
    "start": "node bin/featherlab.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate-content && npm test && npm run build",
    "test:kind": "FEATHERLAB_KIND_TESTS=1 node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/reporters/bail.mjs --test-reporter-destination=stderr \"test/integration/**/*.test.mjs\"",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs",
    "validate-content": "node bin/featherlab.mjs validate-content"
  },
  "dependencies": {
    "dockerode": "^4.0.12",
    "ws": "^8.18.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass-embedded": "1.106.1",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karuifeather/featherlab.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
